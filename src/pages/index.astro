---
import CallToAction from '@/components/sections/CallToAction.astro';
import Differentiators from '@/components/sections/Differentiators.astro';
import Hero from '@/components/sections/Hero.astro';
import Problem from '@/components/sections/Problem.astro';
import ServicesPreview from '@/components/sections/ServicesPreview.astro';
import { site } from '@/config/site';
import PageLayout from '@/layouts/PageLayout.astro';
---

{/* La portada solo cuenta lo esencial; el detalle vive en cada página interior. */}
<PageLayout title={site.title}>
  <Hero />
  <Problem />
  <ServicesPreview />
  <Differentiators />
  <CallToAction />
</PageLayout>

---
import CallToAction from '@/components/sections/CallToAction.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Projects from '@/components/sections/Projects.astro';
import { pages } from '@/content/pages';
import PageLayout from '@/layouts/PageLayout.astro';
import { hasProjects } from '@/lib/sections';
import { withBase } from '@/lib/url';

// Sin proyectos la página no tiene sentido: se redirige a la portada y el menú oculta el enlace.
if (!hasProjects) return Astro.redirect(withBase('/'));

const page = pages.proyectos;
---

<PageLayout title={page.title} description={page.description}>
  <PageHero page={page} />
  <Projects />
  <CallToAction />
</PageLayout>

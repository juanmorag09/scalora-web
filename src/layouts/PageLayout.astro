---
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import Splash from '@/components/layout/Splash.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description?: string | undefined;
  /** Apertura de marca con el logo (solo la portada). */
  splash?: boolean;
}

const { title, description, splash = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  {splash && <Splash />}
  <Header />
  <main id="contenido">
    <slot />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { initMotion } from '@/scripts/motion';

  initMotion();
</script>

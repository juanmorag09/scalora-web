---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import Split from '@/components/ui/Split.astro';
import { differentiators, differentiatorsSection } from '@/content/differentiators';
---

<Section id="diferenciadores" labelledby="diferenciadores-title">
  <Split>
    <Fragment slot="aside">
      <div data-reveal>
        <Eyebrow>{differentiatorsSection.eyebrow}</Eyebrow>
      </div>
      <h2 id="diferenciadores-title" class="differentiators__title" data-reveal="mask">
        {differentiatorsSection.title}
      </h2>
    </Fragment>

    <ul class="differentiators__list" role="list">
      {differentiators.map((item) => (
        <li class="differentiator">
          <h3 class="differentiator__statement" data-reveal="mask">
            {item.statement}
          </h3>
          <p class="differentiator__answer" data-reveal style="--i: 2">
            {item.answer}
          </p>
        </li>
      ))}
    </ul>
  </Split>
</Section>

<style>
  .differentiators__title {
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .differentiators__list {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  /* La línea divisoria se dibuja a medida que cada frase aparece. */
  .differentiator {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-block: 1.375rem;
  }

  .differentiator:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-border-subtle);
    transform-origin: left center;
    transition: scale 1.1s var(--ease-out) 200ms;
  }

  :global(.js.motion-ready) .differentiator:not(:has(.is-revealed))::after {
    scale: 0 1;
  }

  .differentiator:first-child {
    padding-top: 0;
  }

  .differentiator:last-child {
    padding-bottom: 0;
  }

  .differentiator__statement {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .differentiator__answer {
    line-height: 1.55;
    color: var(--color-text-muted);
  }
</style>

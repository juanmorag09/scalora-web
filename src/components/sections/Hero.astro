---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { hero, pillars } from '@/content/hero';
import { withBase } from '@/lib/url';
---

<section id="inicio" class="hero" aria-labelledby="hero-title" data-parallax>
  {/* Halos de luz ambientales: decorativos, se mueven despacio y con el cursor. */}
  <div class="hero__glow" aria-hidden="true">
    <span class="hero__glow-blob hero__glow-blob--a"></span>
    <span class="hero__glow-blob hero__glow-blob--b"></span>
  </div>
  <Container>
    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__badge" data-intro style="--i: 0">
          <span class="hero__badge-dot" aria-hidden="true"></span>
          {hero.badge}
        </p>
        <h1 id="hero-title" class="hero__title">
          <span class="motion-line">
            <span class="motion-line__inner" style="--i: 1">
              {hero.title.lead}
            </span>
          </span>{' '}
          <span class="motion-line">
            <span class="motion-line__inner hero__title-highlight" style="--i: 2">
              {hero.title.highlight}
            </span>
          </span>
        </h1>
        <p class="hero__lead" data-intro style="--i: 3">
          {hero.lead}
        </p>
        <div class="hero__actions">
          <Button href={withBase(hero.primaryAction.href)} magnetic data-intro style="--i: 4">
            {hero.primaryAction.label}
            <span aria-hidden="true">→</span>
          </Button>
          <Button
            href={withBase(hero.secondaryAction.href)}
            variant="secondary"
            data-intro
            style="--i: 5"
          >
            {hero.secondaryAction.label}
          </Button>
        </div>
        <p class="hero__note" data-intro style="--i: 6">
          {hero.note.lead} <span class="hero__note-highlight">{hero.note.highlight}</span>
        </p>
      </div>

      <ol class="pillars" role="list">
        {pillars.map((pillar, index) => (
          <li class="pillar" style={`--i: ${index}`}>
            <span class="pillar__step">{pillar.step}</span>
            <span class="pillar__body">
              <span class="pillar__title">{pillar.title}</span>
              <span class="pillar__description">{pillar.description}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</section>

<style>
  .hero {
    --px: 0;
    --py: 0;

    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  /* ---- Iluminación ambiental ---- */
  .hero__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    translate: calc(var(--px) * -1.5rem) calc(var(--py) * -1rem);
    transition: translate 1.2s var(--ease-out);
  }

  .hero__glow-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    animation:
      motion-fade 1.6s var(--ease-out) var(--intro-offset) both,
      motion-drift var(--duration-ambient) var(--ease-in-out) infinite;
  }

  .hero__glow-blob--a {
    top: 8%;
    right: -8%;
    width: min(38rem, 70vw);
    aspect-ratio: 1;
    background: radial-gradient(circle, var(--color-accent-haze), transparent 65%);
  }

  .hero__glow-blob--b {
    bottom: -20%;
    right: 22%;
    width: min(26rem, 55vw);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(92 124 255 / 0.1), transparent 65%);
    animation-duration: 1.6s, calc(var(--duration-ambient) * 1.4);
    animation-direction: normal, reverse;
  }

  .hero__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-14) var(--space-16);
    padding-block: 6.5rem 6rem;
  }

  .hero__copy {
    flex: 1.25 1 32.5rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-7);
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: var(--space-2) 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .hero__badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .hero__title {
    font-size: var(--text-h1);
    line-height: 1.04;
    letter-spacing: var(--tracking-tight);
  }

  .hero__title-highlight {
    color: var(--color-accent);
  }

  .hero__lead {
    max-width: 38.75rem;
    font-size: 1.1875rem;
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .hero__note {
    line-height: 1.5;
    color: var(--color-text-faint);
  }

  .hero__note-highlight {
    color: var(--color-text);
  }

  /* Escalera Build → Automate → Scale: la altura creciente es el mensaje. */
  .pillars {
    flex: 1 1 23.75rem;
    min-width: 0;
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    margin: 0;
    perspective: 1200px;
    transform-style: preserve-3d;
    rotate: y calc(var(--px) * 8deg);
    transition: rotate 900ms var(--ease-out);
  }

  /* Elemento principal: entra escalonado, flota y se inclina con el cursor. */
  .pillar {
    rotate: x calc(var(--py) * -6deg);
    transition: rotate 900ms var(--ease-out);
    animation:
      motion-rise 900ms var(--ease-out) calc(var(--intro-offset) + 450ms + var(--i) * 140ms) both,
      motion-float 6s var(--ease-in-out) calc(var(--intro-offset) + 1.6s + var(--i) * 0.7s) infinite;
  }

  .pillar {
    flex: 1 1 0;
    min-width: 0;
    min-height: 10.625rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    padding: 1.125rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .pillar:nth-child(2) {
    min-height: 16.25rem;
    background: var(--color-surface-raised);
    border-color: var(--color-border-muted);
  }

  .pillar:nth-child(3) {
    min-height: 21.875rem;
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .pillar__step {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .pillar__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .pillar__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .pillar__description {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .pillar:nth-child(3) .pillar__step,
  .pillar:nth-child(3) .pillar__description {
    color: inherit;
  }

  .pillar:nth-child(3) .pillar__title {
    font-weight: 700;
  }

  .pillar:nth-child(3) .pillar__description {
    font-weight: 500;
  }

  @media (max-width: 30rem) {
    .hero__inner {
      padding-block: 4rem 4.5rem;
    }

    /* Sin ancho para tres columnas, la escalera crece hacia la derecha. */
    .pillars {
      flex-direction: column;
      align-items: flex-start;
    }

    .pillar,
    .pillar:nth-child(2),
    .pillar:nth-child(3) {
      flex: none;
      min-height: 0;
      gap: var(--space-3);
    }

    .pillar:nth-child(1) {
      width: 64%;
    }

    .pillar:nth-child(2) {
      width: 82%;
    }

    .pillar:nth-child(3) {
      width: 100%;
    }
  }
</style>

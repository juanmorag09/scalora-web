---
interface Props {
  /** Con `href` se renderiza un enlace; sin él, un botón. */
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string | undefined;
  /** Atrae el botón levemente hacia el cursor (solo con ratón; ver `scripts/motion.ts`). */
  magnetic?: boolean;
  [key: `data-${string}`]: unknown;
  style?: string;
}

const {
  href,
  variant = 'primary',
  size = 'lg',
  type = 'button',
  class: className,
  magnetic = false,
  ...rest
} = Astro.props;
const classes = ['button', `button--${variant}`, `button--${size}`, className];
const motion = magnetic ? { 'data-magnetic': '' } : {};
---

{href ? (
  <a href={href} class:list={classes} {...motion} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes} {...motion} {...rest}>
    <slot />
  </button>
)}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;

    /* `transform` es del efecto magnético; `scale` del feedback; `translate` queda libre
       para las animaciones de entrada. Así ninguna pisa a otra. */
    transform: translate(var(--mx, 0px), var(--my, 0px));
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      scale var(--duration-base) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }

  .button:hover,
  .button:focus-visible {
    scale: 1.03;
  }

  .button:active {
    scale: 0.97;
    transition-duration: var(--duration-fast);
  }

  /* La flecha del botón avanza un poco: indica hacia dónde lleva. */
  .button > :global(span[aria-hidden='true']) {
    transition: translate var(--duration-base) var(--ease-out);
  }

  .button:hover > :global(span[aria-hidden='true']),
  .button:focus-visible > :global(span[aria-hidden='true']) {
    translate: 0.25rem 0;
  }

  .button--md {
    min-height: var(--tap-target);
    padding-inline: var(--space-5);
    font-size: var(--text-base-sm);
  }

  .button--lg {
    min-height: 3.25rem;
    padding-inline: 1.625rem;
    font-size: var(--text-base);
  }

  .button--primary,
  .button--primary:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .button--primary:hover,
  .button--primary:focus-visible {
    filter: brightness(1.08);
    box-shadow: 0 0.75rem 2rem -0.75rem var(--color-accent-glow);
  }

  .button--secondary,
  .button--secondary:hover {
    background: transparent;
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .button--secondary:hover {
    border-color: var(--color-text-faint);
    background: var(--color-surface);
  }

  .button[disabled] {
    cursor: progress;
    opacity: 0.7;
    scale: 1;
  }
</style>

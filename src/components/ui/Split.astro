---
/**
 * Dos columnas que se apilan solas cuando no caben: una lateral (slot `aside`)
 * y una principal más ancha (slot por defecto).
 */
---

<div class="split">
  <div class="split__aside">
    <slot name="aside" />
  </div>
  <div class="split__main">
    <slot />
  </div>
</div>

<style>
  .split {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-12) var(--space-18);
  }

  .split__aside {
    flex: 1 1 22.5rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .split__main {
    flex: 1.3 1 27.5rem;
    min-width: 0;
  }
</style>

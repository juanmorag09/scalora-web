---
import { site } from '@/config/site';
import { withBase } from '@/lib/url';

interface Props {
  title: string;
  description?: string | undefined;
  /** Las páginas de error no deben indexarse. */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const homeUrl = new URL(withBase('/'), Astro.site);
const ogImage = new URL(withBase(site.ogImage), Astro.site);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: homeUrl.href,
  logo: new URL(withBase('favicon.svg'), Astro.site).href,
  slogan: site.tagline,
  description: site.description,
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.ogLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.href} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} />

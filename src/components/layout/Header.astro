---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import { contactLink, primaryNav, site } from '@/config/site';
import { isCurrentPage, visibleLinks } from '@/lib/navigation';
import { hiddenPaths } from '@/lib/sections';
import { withBase } from '@/lib/url';

const links = visibleLinks(primaryNav, hiddenPaths).map((link) => ({
  ...link,
  href: withBase(link.href),
}));
const current = Astro.url.pathname;
---

<header class="site-header" data-header>
  <Container>
    <div class="site-header__inner">
      <a class="site-header__brand" href={withBase('/')} aria-label={`${site.name}, ir al inicio`}>
        <Logo />
      </a>

      <nav class="site-nav" id="primary-nav" aria-label="Principal" data-nav>
        <ul class="site-nav__list" role="list">
          {links.map((link) => (
            <li>
              <a
                class="site-nav__link u-link"
                href={link.href}
                aria-current={isCurrentPage(current, link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="site-header__actions">
        <Button href={withBase(contactLink.href)} variant="secondary" size="md" magnetic>
          {contactLink.label}
        </Button>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-nav"
          data-nav-toggle
          hidden
        >
          <span class="visually-hidden" data-nav-toggle-label>
            Abrir menú
          </span>
          <span class="nav-toggle__icon nav-toggle__icon--open">
            <Icon name="menu" size={24} />
          </span>
          <span class="nav-toggle__icon nav-toggle__icon--close">
            <Icon name="close" size={24} />
          </span>
        </button>
      </div>
    </div>
  </Container>
</header>

<script>
  import { initMobileNav } from '@/scripts/mobile-nav';

  initMobileNav();
</script>

<style>
  /* Barra fija: transparente arriba; al desplazarse aparece un fondo translúcido. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-slow) var(--ease-out);
  }

  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(11 13 18 / 0.78);
    backdrop-filter: blur(14px) saturate(140%);
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  .site-header[data-scrolled='true'] {
    border-bottom-color: var(--color-border-subtle);
  }

  .site-header[data-scrolled='true']::before {
    opacity: 1;
  }

  /* Animación sencilla de cada carga (la apertura completa solo está en la portada, la
     primera vez): las barras del logo suben una tras otra y el nombre se desliza. */
  .site-header__brand {
    animation: motion-fade 600ms var(--ease-out) both;
  }

  .site-header__brand :global(.logo__bar) {
    transform-origin: bottom;
    animation: brand-bar 550ms var(--ease-out) both;
  }

  .site-header__brand :global(.logo__bar--2) {
    animation-delay: 90ms;
  }

  .site-header__brand :global(.logo__bar--3) {
    animation-delay: 180ms;
  }

  .site-header__brand :global(.logo__word) {
    animation: brand-word 600ms var(--ease-out) 200ms both;
  }

  @keyframes brand-bar {
    from {
      scale: 1 0;
    }
  }

  @keyframes brand-word {
    from {
      opacity: 0;
      translate: -0.5rem 0;
    }
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-8);
    padding-block: 0.875rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-7);
    margin: 0;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: 2px;
    font-size: var(--text-base-sm);
    font-weight: 500;
  }

  .site-nav__link[aria-current='page'] {
    color: var(--color-text);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--tap-target);
    height: var(--tap-target);
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    cursor: pointer;
  }

  .nav-toggle__icon--close,
  .nav-toggle[aria-expanded='true'] .nav-toggle__icon--open {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon--close,
  .nav-toggle[aria-expanded='false'] .nav-toggle__icon--open {
    display: block;
    animation: toggle-icon var(--duration-base) var(--ease-out);
  }

  @keyframes toggle-icon {
    from {
      opacity: 0;
      rotate: -90deg;
      scale: 0.6;
    }
  }

  /* Móvil: el menú pasa a un panel desplegable debajo de la barra. */
  @media (max-width: 47.9375rem) {
    /* Marca, «Hablemos» y menú caben en una sola fila: la barra fija ocupa menos. */
    .site-header__inner {
      column-gap: var(--space-3);
    }

    .nav-toggle {
      display: inline-flex;
    }

    .site-nav {
      order: 3;
      flex-basis: 100%;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-block: var(--space-2);
      border-top: 1px solid var(--color-border-subtle);
    }

    .site-nav__link {
      width: 100%;
      min-height: 3rem;
      font-size: var(--text-md);
    }

    /* Solo se oculta si hay JavaScript para volver a abrirlo. Abre y cierra con un
       desplazamiento corto; `allow-discrete` deja animar también el cierre. */
    :global(.js) .site-nav {
      transition:
        opacity var(--duration-base) var(--ease-out),
        translate var(--duration-base) var(--ease-out),
        display var(--duration-base) allow-discrete;
    }

    :global(.js) .site-nav:not([data-open='true']) {
      display: none;
      opacity: 0;
      translate: 0 -0.5rem;
    }

    :global(.js) .site-nav[data-open='true'] {
      @starting-style {
        opacity: 0;
        translate: 0 -0.5rem;
      }
    }

    /* Los enlaces entran uno tras otro. */
    .site-nav[data-open='true'] li {
      transition:
        opacity var(--duration-slow) var(--ease-out),
        translate var(--duration-slow) var(--ease-out);
      transition-delay: calc(var(--n, 0) * 50ms);

      @starting-style {
        opacity: 0;
        translate: 0 -0.375rem;
      }
    }

    .site-nav__list li:nth-child(2) {
      --n: 1;
    }

    .site-nav__list li:nth-child(3) {
      --n: 2;
    }

    .site-nav__list li:nth-child(4) {
      --n: 3;
    }

    /* En el panel móvil el subrayado se sustituye por el color. */
    .site-nav__link::after {
      display: none;
    }
  }
</style>

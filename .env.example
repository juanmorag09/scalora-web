# Copia este archivo como .env y ajusta los valores. Ninguno es obligatorio en desarrollo.

# URL pública del sitio, sin barra final. Se usa en canonical, Open Graph, sitemap y robots.txt.
# En GitHub Pages el flujo de despliegue la calcula solo.
SITE_URL=https://tu-usuario.github.io

# Ruta base si el sitio no vive en la raíz del dominio (GitHub Pages de proyecto: /nombre-del-repo).
BASE_PATH=/

# URL que recibe el formulario de contacto (POST con JSON). Si se deja vacío,
# el formulario valida pero avisa que el envío no está conectado.
PUBLIC_CONTACT_ENDPOINT=

# Correo de contacto que se muestra en la página. Si se deja vacío, no se muestra.
PUBLIC_CONTACT_EMAIL=

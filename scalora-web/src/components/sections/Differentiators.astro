---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import Split from '@/components/ui/Split.astro';
import { differentiators, differentiatorsSection } from '@/content/differentiators';
---

<Section id="diferenciadores" labelledby="diferenciadores-title">
  <Split>
    <Fragment slot="aside">
      <Eyebrow>{differentiatorsSection.eyebrow}</Eyebrow>
      <h2 id="diferenciadores-title" class="differentiators__title">
        {differentiatorsSection.title}
      </h2>
    </Fragment>

    <ul class="differentiators__list" role="list">
      {differentiators.map((item) => (
        <li class="differentiator">
          <h3 class="differentiator__statement">{item.statement}</h3>
          <p class="differentiator__answer">{item.answer}</p>
        </li>
      ))}
    </ul>
  </Split>
</Section>

<style>
  .differentiators__title {
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .differentiators__list {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .differentiator {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-block: 1.375rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .differentiator:first-child {
    padding-top: 0;
  }

  .differentiator:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .differentiator__statement {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .differentiator__answer {
    line-height: 1.55;
    color: var(--color-text-muted);
  }
</style>

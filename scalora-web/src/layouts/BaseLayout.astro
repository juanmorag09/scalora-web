---
import '@fontsource-variable/sora';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/global.css';

import bodyFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import displayFont from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import Seo from '@/components/layout/Seo.astro';
import { site } from '@/config/site';
import { withBase } from '@/lib/url';

interface Props {
  title: string;
  description?: string | undefined;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />

    {/* Las dos fuentes del primer pantallazo se precargan para evitar saltos de texto. */}
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />

    <Seo title={title} description={description} noindex={noindex} />

    {/* Marca que hay JS antes del primer pintado: evita el parpadeo del menú móvil. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 10;
    padding: var(--space-3) var(--space-5);
    background: var(--color-accent);
    border-radius: var(--radius-pill);
    font-weight: 600;
    color: var(--color-on-accent);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
